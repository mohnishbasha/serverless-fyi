---
import { Picture } from 'astro:assets';
import { ogPath, type Post, postPath, summaryOf } from '../lib/posts';
import { readingTime } from '../lib/reading-time';
import { url } from '../lib/urls';
import TagList from './TagList.astro';

export interface Props {
  post: Post;
  headingLevel?: 2 | 3;
  /** Large card spanning two columns (home "Latest posts" lead). */
  featured?: boolean;
  /** Load the thumbnail eagerly (above-the-fold cards only). */
  eager?: boolean;
}
const { post, headingLevel = 3, featured = false, eager = false } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3';
const date = post.data.pubDate;
const cover = post.data.cover;
const sizes = featured
  ? '(min-width: 64rem) 46rem, (min-width: 40rem) 90vw, 100vw'
  : '(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 100vw';
---

<article class:list={['card', { featured }]}>
  <div class="card-thumb">
    {cover ? (
      <Picture
        src={cover}
        alt=""
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={featured ? [480, 800, 1200] : [360, 560, 720]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <img
        src={url(ogPath(post.data.slug))}
        alt=""
        width="1200"
        height="630"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    )}
  </div>
  <div class="card-body">
    {featured && <span class="badge">Latest issue</span>}
    <H>
      <a href={url(postPath(post))}>{post.data.title}</a>
    </H>
    <p>{summaryOf(post)}</p>
    <TagList tags={post.data.tags.slice(0, 3)} />
    <p class="meta">
      <time datetime={date.toISOString()}>
        {date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
      </time>
      {' · '}
      {readingTime(post.body ?? '')} min read
    </p>
  </div>
</article>
