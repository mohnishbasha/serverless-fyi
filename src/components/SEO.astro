---
/** Every <head> meta tag from docs/SEO_AEO.md § Per-page head. Asserted by scripts/validate-seo.ts. */
import { INDEXABLE } from '../lib/env';
import { canonicalFor, clampDescription, pageTitle, robotsContent } from '../lib/seo';
import { SITE } from '../lib/site';
import { abs, url } from '../lib/urls';

export interface Props {
  title?: string | undefined;
  description: string;
  type?: 'website' | 'article';
  ogImage: string;
  ogImageAlt: string;
  noindex?: boolean | undefined;
  canonical?: string | undefined;
  markdownAlt?: string | undefined;
  article?: { published: Date; modified?: Date | undefined; tags: string[]; author: string } | undefined;
}

const {
  title,
  description,
  type = 'website',
  ogImage,
  ogImageAlt,
  noindex,
  canonical,
  markdownAlt,
  article,
} = Astro.props;
const fullTitle = pageTitle(title);
const desc = clampDescription(description);
const canonicalUrl =
  canonical ?? canonicalFor(Astro.url.pathname, Astro.site?.toString() ?? '', import.meta.env.BASE_URL);
const ogImageUrl = /^https?:/.test(ogImage) ? ogImage : abs(ogImage);
---

<title>{fullTitle}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content={robotsContent({ indexable: INDEXABLE, noindex: !!noindex })} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={title ?? SITE.homeTitle} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
{article && (
  <>
    <meta property="article:published_time" content={article.published.toISOString()} />
    <meta property="article:modified_time" content={(article.modified ?? article.published).toISOString()} />
    <meta property="article:author" content={abs('/authors/')} />
    {article.tags.map((t) => (
      <meta property="article:tag" content={t} />
    ))}
  </>
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.twitter} />
<meta name="twitter:creator" content={SITE.twitter} />
<meta name="twitter:title" content={title ?? SITE.homeTitle} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<link rel="alternate" type="application/rss+xml" title={`${SITE.name} (RSS)`} href={url('/rss.xml')} />
<link rel="alternate" type="application/atom+xml" title={`${SITE.name} (Atom)`} href={url('/atom.xml')} />
<link rel="alternate" type="application/feed+json" title={`${SITE.name} (JSON Feed)`} href={url('/feed.json')} />
{markdownAlt && <link rel="alternate" type="text/markdown" href={url(markdownAlt)} />}
<link rel="sitemap" href={url('/sitemap-index.xml')} />
