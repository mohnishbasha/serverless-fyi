---
/* Hidden without JS (prefers-color-scheme still applies). < 1 KB inline. */
---

<button class="icon-btn theme-toggle" type="button" aria-label="Toggle dark mode" aria-pressed="false" hidden>
  <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
    <path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
  <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="5" fill="currentColor"></circle>
    <path
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"
    ></path>
  </svg>
</button>
<script is:inline>
  (function () {
    const root = document.documentElement;
    const mq = window.matchMedia('(prefers-color-scheme: dark)');
    const isDark = function () {
      return root.dataset.theme ? root.dataset.theme === 'dark' : mq.matches;
    };
    document.querySelectorAll('.theme-toggle').forEach(function (b) {
      b.hidden = false;
      b.setAttribute('aria-pressed', String(isDark()));
      b.addEventListener('click', function () {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        b.setAttribute('aria-pressed', String(next === 'dark'));
        try {
          localStorage.setItem('theme', next);
        } catch {
          // storage unavailable (private mode, blocked)
        }
      });
    });
  })();
</script>
