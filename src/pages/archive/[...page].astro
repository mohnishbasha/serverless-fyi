---
import type { GetStaticPaths, Page } from 'astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Pagination from '../../components/Pagination.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ctx } from '../../lib/env';
import { blog, breadcrumbList, itemList } from '../../lib/jsonld';
import { getPosts, type Post, postPath } from '../../lib/posts';
import { SITE } from '../../lib/site';
import { url } from '../../lib/urls';

export const getStaticPaths = (async ({ paginate }) =>
  paginate(await getPosts(), { pageSize: SITE.postsPerArchivePage })) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}
const { page } = Astro.props;
const years = new Map<number, Post[]>();
for (const p of page.data) {
  const y = p.data.pubDate.getUTCFullYear();
  years.set(y, [...(years.get(y) ?? []), p]);
}
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const n = page.currentPage;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const strip = (u?: string) => (u ? u.replace(base, '') : undefined);
---

<BaseLayout
  title={n > 1 ? `Archive — page ${n}` : 'Archive: every post'}
  description={`Every ${SITE.name} issue in one place, grouped by year: data, AI, distributed systems and startups explained in two minutes.${n > 1 ? ` Page ${n}.` : ''}`}
  ogImage="/og/default.png"
  ogImageAlt={`${SITE.name} archive`}
  jsonld={[
    blog(ctx),
    itemList(
      page.data.map((p) => ({ path: postPath(p), name: p.data.title })),
      ctx,
    ),
    breadcrumbList(
      [
        { name: 'Home', path: '/' },
        { name: 'Archive', path: '/archive/' },
      ],
      ctx,
    ),
  ]}
>
  <script is:inline define:vars={{ archiveBase: url('/archive/') }}>
    // Beehiiv used /archive?page=N; static hosting can't route query strings.
    const n = parseInt(new URLSearchParams(location.search).get('page') || '', 10);
    if (n > 0) location.replace(n === 1 ? archiveBase : archiveBase + n + '/');
  </script>
  <div class="wrap-narrow">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Archive', path: '/archive/' },
      ]}
    />
    <header class="page-intro">
      <h1>Archive{n > 1 && <span class="muted"> · page {n}</span>}</h1>
      <p>{page.total} posts, newest first.</p>
    </header>
    {[...years.entries()].map(([year, list]) => (
      <section aria-labelledby={`y-${year}`}>
        <h2 class="year" id={`y-${year}`}>
          {year}
        </h2>
        <ul class="archive-list">
          {list.map((p) => (
            <li>
              <time datetime={p.data.pubDate.toISOString()}>{fmt(p.data.pubDate)}</time>
              <a href={url(postPath(p))}>{p.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <Pagination prev={strip(page.url.prev)} next={strip(page.url.next)} current={n} last={page.lastPage} />
  </div>
</BaseLayout>
