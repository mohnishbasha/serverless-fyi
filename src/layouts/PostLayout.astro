---
import type { MarkdownHeading } from 'astro';
import { Picture } from 'astro:assets';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import PostCard from '../components/PostCard.astro';
import Subscribe from '../components/Subscribe.astro';
import TagList from '../components/TagList.astro';
import Tldr from '../components/Tldr.astro';
import TOC from '../components/TOC.astro';
import { ctx } from '../lib/env';
import { blogPosting, breadcrumbList, faqPage, person } from '../lib/jsonld';
import { type Author, ogPath, type Post, postMdPath, postPath } from '../lib/posts';
import { SITE } from '../lib/site';
import { tagLabel } from '../lib/tags';
import { abs, url } from '../lib/urls';
import BaseLayout from './BaseLayout.astro';

export interface Props {
  post: Post;
  author: Author;
  headings: MarkdownHeading[];
  words: number;
  minutes: number;
  prev?: Post | undefined;
  next?: Post | undefined;
  related: Post[];
}
const { post, author, headings, words, minutes, prev, next, related } = Astro.props;
const d = post.data;
const showAeo = !d.aeoPending && !!d.tldr;
const faq = d.aeoPending ? [] : d.faq;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: tagLabel(d.tags[0] ?? 'posts'), path: `/t/${d.tags[0]}/` },
  { name: d.title, path: postPath(post) },
];
const fmt = (x: Date) =>
  x.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const shareUrl = encodeURIComponent(abs(postPath(post)));
const shareText = encodeURIComponent(d.title);
---

<BaseLayout
  title={d.title}
  description={d.description}
  type="article"
  ogImage={ogPath(d.slug)}
  ogImageAlt={`${d.title} — ${SITE.name}`}
  noindex={d.noindex || d.draft}
  canonical={d.canonical}
  markdownAlt={postMdPath(post)}
  article={{ published: d.pubDate, modified: d.updatedDate, tags: d.tags, author: author.name }}
  jsonld={[
    blogPosting(
      {
        slug: d.slug,
        title: d.title,
        description: d.description,
        pubDate: d.pubDate,
        updatedDate: d.updatedDate,
        tags: d.tags,
        image: ogPath(d.slug),
        wordCount: words,
      },
      author,
      ctx,
    ),
    person(author, ctx),
    breadcrumbList(crumbs, ctx),
    faqPage(faq),
  ]}
>
  <article class="wrap-narrow" data-pagefind-body>
    <Breadcrumbs items={crumbs} />
    <header class="post-header">
      <h1>{d.title}</h1>
      {d.subtitle && <p class="subtitle">{d.subtitle}</p>}
      <p class="byline">
        <img src={url(author.avatar)} alt="" width="40" height="40" loading="lazy" decoding="async" />
        <a href={url('/authors/')} rel="author">
          {author.name}
        </a>
        <span class="dot"></span>
        <time datetime={d.pubDate.toISOString()}>{fmt(d.pubDate)}</time>
        {d.updatedDate && (
          <>
            <span class="dot" />
            <span>
              Updated <time datetime={d.updatedDate.toISOString()}>{fmt(d.updatedDate)}</time>
            </span>
          </>
        )}
        <span class="dot"></span>
        <span>{minutes} min read</span>
      </p>
    </header>

    {d.cover && (
      <figure class="cover">
        <Picture
          src={d.cover}
          alt={d.coverAlt ?? ''}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[480, 800, 1200]}
          sizes="(min-width: 46rem) 46rem, 100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    )}

    {showAeo && <Tldr tldr={d.tldr ?? ''} takeaways={d.keyTakeaways} />}
    {words > SITE.tocMinWords && <TOC headings={headings} />}

    <div class="prose">
      <slot />
    </div>

    <Faq faq={faq} />

    <footer class="post-footer">
      <TagList tags={d.tags} label="Post tags" />
      <p class="share">
        <span>Share:</span>
        <a href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}&via=mohinishbasha`}>X</a>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}>LinkedIn</a>
        <a href={`mailto:?subject=${shareText}&body=${shareUrl}`}>Email</a>
        <a href={url(postMdPath(post))} type="text/markdown">
          Read as Markdown
        </a>
      </p>
      {(prev || next) && (
        <nav class="post-nav" aria-label="Previous and next posts">
          {prev ? (
            <a href={url(postPath(prev))} rel="prev">
              <span class="label">← Previous</span>
              {prev.data.title}
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a class="next" href={url(postPath(next))} rel="next">
              <span class="label">Next →</span>
              {next.data.title}
            </a>
          )}
        </nav>
      )}
    </footer>
  </article>

  {related.length > 0 && (
    <section class="wrap related" aria-labelledby="related-heading">
      <h2 class="section-title" id="related-heading">
        Related posts
      </h2>
      <ul class="cards">
        {related.map((p) => (
          <li>
            <PostCard post={p} />
          </li>
        ))}
      </ul>
    </section>
  )}
  <div class="wrap-narrow" style="margin-top:var(--space-7)">
    <Subscribe id="post-subscribe" />
  </div>
  <script is:inline>
    // Code blocks: add a soft-wrap toggle (pre scrolls horizontally by default).
    document.querySelectorAll('.prose pre').forEach(function (pre) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'code-wrap-toggle';
      b.textContent = 'Wrap';
      b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', function () {
        const on = pre.classList.toggle('wrap');
        b.setAttribute('aria-pressed', String(on));
      });
      const wrap = document.createElement('div');
      wrap.className = 'code-block';
      pre.parentNode.insertBefore(wrap, pre);
      wrap.append(pre, b);
    });
  </script>
</BaseLayout>
