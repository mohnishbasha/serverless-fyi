# Copy to .env (never commit .env). Values below are placeholders.

# --- PostgreSQL ---
POSTGRES_USER=listmonk
# Generate: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=change-me
POSTGRES_DB=listmonk

# --- listmonk super admin (created on first install only) ---
LISTMONK_ADMIN_USER=admin
# Use a long random password; rotate in the UI afterwards if desired.
LISTMONK_ADMIN_PASSWORD=change-me-long-random

# --- Caddy ---
# Email for Let's Encrypt registration/expiry notices.
ACME_EMAIL=you@example.com
# Space-separated CIDRs allowed to reach /admin* and /api* (your home/office IPs).
ADMIN_ALLOW_CIDRS=203.0.113.7/32 2001:db8::/48

# --- Timezone ---
TZ=UTC

# --- Backups (from terraform output) ---
AWS_REGION=us-east-1
BACKUP_BUCKET=serverlessfyi-listmonk-backups-xxxxxxxx
# KMS key ID or ARN used for SSE-KMS (terraform output backup_kms_key_arn)
BACKUP_KMS_KEY_ID=arn:aws:kms:us-east-1:111122223333:key/00000000-0000-0000-0000-000000000000
# IAM user listmonk-backup access key (terraform output)
BACKUP_AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
BACKUP_AWS_SECRET_ACCESS_KEY=change-me
# Hour (UTC, 00-23, two digits) the nightly dump runs at :15
BACKUP_HOUR_UTC=03
