# Copy to .env.local for local overrides. Never commit real values.

# Absolute site origin (no trailing slash). Staging: https://mohnishbasha.github.io
SITE_URL=https://www.serverless.fyi
# Base path. Staging: /serverless-fyi/
BASE_PATH=/
# "true" only for production: enables indexing, robots Allow and CNAME.
PUBLIC_INDEXABLE=false

# Newsletter provider (ADR-028): kit (current) | listmonk (planned before ~10k subscribers) | buttondown | beehiiv (legacy) | none
PUBLIC_NEWSLETTER_PROVIDER=kit
# Public identifier: Kit form id, listmonk list UUID, Buttondown username or Beehiiv publication UUID.
PUBLIC_NEWSLETTER_ID=
# Optional. Kit: host from the form's HTML embed code (default https://app.kit.com).
# listmonk: public base URL, e.g. https://lists.serverless.fyi
PUBLIC_NEWSLETTER_URL=

# Optional Cloudflare Web Analytics token (cookieless).
PUBLIC_CF_ANALYTICS_TOKEN=

# Migration only (never in CI, never committed):
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
