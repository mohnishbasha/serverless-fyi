{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "migration/raw",
    "playwright-report",
    "test-results",
    ".lighthouseci",
    "coverage"
  ],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"]
  }
}
