{
  "name": "serverless-fyi",
  "version": "1.0.0",
  "private": true,
  "description": "2 Minute Serverless — static site for www.serverless.fyi (Astro → GitHub Pages).",
  "type": "module",
  "license": "MIT",
  "author": "Serverless Ventures LLC",
  "repository": "github:mohnishbasha/serverless-fyi",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint . && prettier --check . && markdownlint-cli2 \"**/*.{md,mdx}\" \"#node_modules\" && cspell --no-progress \"src/**/*.{md,mdx,astro}\"",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "validate": "tsx scripts/check-content.ts && tsx scripts/validate-parity.ts && tsx scripts/validate-seo.ts && tsx scripts/validate-feeds.ts && tsx scripts/validate-dist.ts && html-validate \"dist/**/*.html\"",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build && pnpm validate",
    "new-post": "tsx scripts/new-post.ts",
    "migrate:fetch": "tsx migration/fetch-beehiiv.ts",
    "migrate:scrape": "tsx migration/scrape-beehiiv.ts",
    "migrate:convert": "tsx migration/html-to-md.ts && tsx migration/localize-images.ts && tsx migration/build-manifest.ts",
    "versions": "bash scripts/check-versions.sh",
    "prepare": "lefthook install || true",
    "licenses:gen": "tsx scripts/third-party-licenses.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/mdx": "8.1.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@resvg/resvg-js": "2.6.2",
    "astro": "7.4.2",
    "rehype-stringify": "10.0.1",
    "remark-rehype": "11.1.2",
    "satori": "0.63.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@fontsource/inter": "5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "cheerio": "1.2.0",
    "cspell": "10.4.0",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "fast-xml-parser": "5.11.2",
    "globals": "17.13.0",
    "hast-util-from-html": "2.0.3",
    "hast-util-select": "6.0.4",
    "hast-util-to-html": "9.0.5",
    "hast-util-to-string": "3.0.1",
    "html-validate": "11.17.0",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "mdast-util-mdx-jsx": "3.2.0",
    "pagefind": "1.5.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "rehype-parse": "9.0.1",
    "rehype-remark": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "sharp",
      "@resvg/resvg-js"
    ]
  }
}
